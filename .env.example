# Optional. The demo runs with all of these empty.
# Do not set NEXT_PUBLIC_SHOWUP_LIVE=true unless you intend to leave demo mode.

NEXT_PUBLIC_SHOWUP_LIVE=false
NEXT_PUBLIC_LIVE_CITY=columbia-sc
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase JS (gated; not a production database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (gated; no live charges in demo mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Optional /api/agent (xAI). Leave blank to skip.
XAI_API_KEY=
XAI_MODEL=
